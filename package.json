{
  "name": "ottopus-ink",
  "productName": "Ottopus Ink",
  "version": "0.1.0",
  "description": "A desktop universal wallet driven by the coding agent you already have. The agent proposes, you sign.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.0",
    "electron": "45.2.1",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource/figtree": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/quicksand": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "allowScripts": {
    "electron@45.2.1": true
  }
}
